[Unit]
Description=Sekha Node 3 Sensory Layer (labelled ingest and buffer)
After=network.target network-online.target sekha-embed.service
Wants=network-online.target sekha-embed.service
Documentation=https://github.com/Duara-Cortex/sekha-sensory-buffer

[Service]
Type=simple
User=admin
Group=admin
# All configuration comes from the env file (see .env.example); the leading '-' means a
# missing file is allowed and built-in defaults apply.
EnvironmentFile=-/etc/sekha/sensory-buffer.env
ExecStart=/usr/local/bin/sekha-sensory-buffer
Restart=always
RestartSec=3s

# Resource and sandbox controls
LimitNOFILE=65535
# Node CPU cap: no Sekha node may use more than 2 threads (more took Node 3 down on
# 2026-09-29). Both Sekha units are pinned to the same two cores, so ingest and embedding
# together never use more than 2.
CPUAffinity=0 1
Environment=GOMAXPROCS=2
# Memory cap, so a runaway process is killed and restarted instead of freezing the node.
# The buffer is RAM only: a kill loses every chunk not yet delivered. The default
# SEKHA_CAPACITY_MB=64 measured ~300 MiB RSS. If you raise the budget, keep MemoryMax at
# about 3 x SEKHA_CAPACITY_MB + 300M, with MemoryHigh and GOMEMLIMIT below it.
MemoryHigh=400M
MemoryMax=512M
# Makes Go collect garbage harder before reaching MemoryHigh (and works even where the
# memory cgroup controller is off). Keep it below MemoryHigh.
Environment=GOMEMLIMIT=350MiB

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sekha-sensory-buffer

# Hardening / Isolation
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
