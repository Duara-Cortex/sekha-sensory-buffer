# sekha-sensory-buffer (Node 3) configuration.
# On Node 3 copy to /etc/sekha/sensory-buffer.env (mode 0600, it may hold an API key).
# Every key is optional; the value shown is the built-in default. Invalid values stop the
# service at startup with a message naming the key.
# Keep regex values in single quotes: systemd (and shells) strip backslashes from unquoted values.

# --- HTTP server ---------------------------------------------------------------------
SEKHA_HOST=0.0.0.0
SEKHA_PORT=8081
# Max request body for /ingest (bytes).
SEKHA_MAX_BODY_BYTES=16777216
# Write timeout (seconds). Large documents with a task are embedded before the response,
# so this is generous; a timed-out response may make a client retry and store twice.
SEKHA_HTTP_WRITE_TIMEOUT_S=120

# --- Buffer --------------------------------------------------------------------------
# Byte budget for buffered chunks (text + per-record structure, ~= live data). Unacknowledged
# chunks are never evicted: when full, /ingest returns 503. The process needs about 2-3x this
# in RAM because of Go garbage-collection headroom (64 -> ~300 MiB RSS measured on Node 3).
SEKHA_CAPACITY_MB=64
# Retry-After (seconds) sent with a 503 buffer_full response.
SEKHA_BACKPRESSURE_RETRY_AFTER_S=5
# GET /drain page size when ?max is omitted, and the cap on ?max.
SEKHA_DRAIN_MAX_DEFAULT=256
SEKHA_DRAIN_MAX_LIMIT=4096

# --- Push to Node 2 -----------------------------------------------------------------------
# Node 2's receive endpoint. When set, Node 3 POSTs the oldest unacknowledged chunks there as
# one JSON batch (same shape as a /drain response) and evicts them only after a 200 reply;
# /drain and /ack are then disabled. Empty = pull mode (Node 2 drains and acks).
SEKHA_PUSH_URL=
# Bearer token sent to Node 2, if it needs one. Never logged.
SEKHA_PUSH_API_KEY=
# Chunks per POST.
SEKHA_PUSH_BATCH=256
# Wait between checks when the buffer is empty, and the first retry delay after a failure (ms).
SEKHA_PUSH_INTERVAL_MS=1000
# Retry delays double after each failure up to this cap (ms).
SEKHA_PUSH_MAX_BACKOFF_MS=30000
# Per-POST timeout (ms). A timeout counts as a failure: the batch is kept and sent again.
SEKHA_PUSH_TIMEOUT_MS=10000

# --- Chunking ------------------------------------------------------------------------
# Max bytes per chunk. Longer turns/paragraphs/lines are split, keeping turn_id/parent_id.
# 1024 bytes (~250 tokens) keeps each chunk inside MiniLM's window so the score covers it.
SEKHA_CHUNK_MAX_BYTES=1024

# --- Floor (rule-based; nothing is dropped for a low score) ----------------------------
# A chunk that is entirely a separator line.
SEKHA_FLOOR_SEPARATOR_PATTERN='^\s*(?:-{3,}|={3,}|_{3,}|\*{3,}|~{3,}|#{3,}|\+{3,})\s*$'
# A heartbeat/ping line (every line of the chunk must match) ...
SEKHA_FLOOR_HEARTBEAT_PATTERN='(?i)^\s*(?:ping|pong|ping\s+\S+\s+\(\S+\).*|\d+\s+bytes\s+from\s+.*\bicmp_seq=\d+.*|.*\bheartbeat\b.*\b(?:ok|alive|healthy)\s*)$'
# ... unless it also matches this (a failing heartbeat is information and is kept).
SEKHA_FLOOR_HEARTBEAT_EXCLUDE_PATTERN='(?i)\b(?:error|fail|failed|failure|miss|missed|missing|timeout|timed\s+out|lost|unreachable|not|down|critical|fatal|warn|warning)\b'
# Input types the heartbeat rule applies to (comma list; empty = none).
SEKHA_FLOOR_HEARTBEAT_TYPES=log
# Input types where exact repeats within one request are dropped (dialogue: same speaker + same text + same question answered).
SEKHA_FLOOR_DEDUP_TYPES=log,document,dialogue

# --- Task scoring (MiniLM embeddings) --------------------------------------------------
# openai = any OpenAI-compatible /v1/embeddings (Node 3's local llama-server); none = no scoring.
SEKHA_EMBED_PROVIDER=openai
SEKHA_EMBED_URL=http://127.0.0.1:8086/v1/embeddings
# Bearer token for the embedding server. Leave empty for the local server bound to 127.0.0.1.
SEKHA_EMBED_API_KEY=
SEKHA_EMBED_MODEL=all-MiniLM-L6-v2
SEKHA_EMBED_DIM=384
# Per-request timeout (ms). On failure chunks are still stored, with score_status=embedder_unavailable.
SEKHA_EMBED_TIMEOUT_MS=10000
SEKHA_EMBED_BATCH_SIZE=32
# Cosine similarity at or above which a chunk is strong (processed by Node 2's model).
# Weak chunks are only stored. Provisional: to be set by experiment.
SEKHA_STRONG_THRESHOLD=0.30

# --- Local embedding server (read only by systemd/sekha-embed.service) ---------------------
SEKHA_EMBED_SERVER_BIN=/usr/local/bin/llama-server
SEKHA_EMBED_MODEL_PATH=/opt/sekha/models/all-MiniLM-L6-v2.gguf
# Keep 127.0.0.1 unless another node must reach it (then also set --api-key and SEKHA_EMBED_API_KEY).
SEKHA_EMBED_BIND=127.0.0.1
# Must match the port in SEKHA_EMBED_URL.
SEKHA_EMBED_PORT=8086
SEKHA_EMBED_THREADS=2
# Parallel slots. llama-server divides the context across slots: keep SEKHA_EMBED_CTX = 512 x this.
SEKHA_EMBED_PARALLEL=1
SEKHA_EMBED_CTX=512
# Physical batch; must be >= the tokens in one chunk (MiniLM max 512).
SEKHA_EMBED_UBATCH=512

# --- Deprecated /filter endpoint (removed in Task 34) -------------------------------------
SEKHA_FILTER_THRESHOLD=0.75
